# Sentinel configuration
#
# SECRET_KEY: MUST be overridden - no safe default exists. This signs every
# login session's JWT. The value shipped as the in-code default is public
# (visible to anyone who reads config.py on GitHub), so leaving this unset
# lets an attacker mint a valid session for any user/role. Generate one with,
# e.g., `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=change-me-to-a-long-random-secret

# DEBUG: set to false for anything other than local development. When
# DEBUG=false, the app refuses to start if SECRET_KEY is still unset/default
# (see app/config.py).
DEBUG=true

# DATABASE_URL: Postgres connection string for the app service, run
# directly against a host Postgres (this is what app/config.py reads).
DATABASE_URL=postgresql://sentinel:sentinel_dev@127.0.0.1:5432/sentinel

# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB: only used by
# infra/docker-compose.yml's `db` service (the official postgres image
# bootstraps its role/database from these on first boot) - irrelevant if
# you're running Postgres yourself and just setting DATABASE_URL above.
# docker-compose's own DATABASE_URL for the `app` service is built from
# these same three vars, so overriding POSTGRES_PASSWORD here is enough -
# no need to also edit DATABASE_URL to keep the two in sync under Compose.
# If you set DATABASE_URL directly (e.g. to point `app` at an external/
# managed Postgres instead of the `db` service), that value wins outright
# and these three are ignored by `app`.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev
POSTGRES_DB=sentinel

# Sentinel Camera Grid Gateway Configuration
GRID_HOST=cctv.corp8.cloud
GRID_RTSP_HOST=103.250.160.189
GRID_RTSP_PORT=8554
GRID_RTSP_USER=your_username@example.com
GRID_RTSP_PASS=your_password

# DISABLE_INGESTION: turns off RTSP/MediaMTX stream registration while
# leaving the camera-catalogue poll itself running (see app/main.py's
# lifespan() docstring for the full explanation). docker-compose.yml
# sets this to true by default for the app service; leave unset (false)
# for a bare/local run if you want the app to actually register live
# streams with MediaMTX.
DISABLE_INGESTION=false

# Login rate limiting (optional - sane defaults if unset, see
# app/auth/rate_limit.py). LOGIN_MAX_ATTEMPTS failed logins for the same
# (client IP, username) within LOGIN_WINDOW_SECONDS trigger a
# LOGIN_LOCKOUT_SECONDS lockout for that pair.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=300
# LOGIN_LOCKOUT_SECONDS=900

# MEDIAMTX_CORS_ORIGIN: the browser origin allowed to embed HLS/WebRTC
# playback from the `mediamtx` service. Left unset, defaults to
# 'http://localhost:8000' for local dev. MUST be set to the real deployed
# origin (e.g. https://your-real-domain.example) in production, or
# HLS/WebRTC playback fails with a CORS error in the browser console
# (AuditReport1.md finding 11 / 3.2).
MEDIAMTX_CORS_ORIGIN=http://localhost:8000

# DOMAIN: real, DNS-resolvable hostname pointed at this host, used by the
# `caddy` reverse-proxy service (infra/Caddyfile) to obtain automatic
# Let's Encrypt HTTPS. Leave unset for local development - caddy then
# falls back to `localhost` with a locally-trusted self-signed cert.
DOMAIN=your-real-domain.example
